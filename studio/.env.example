# Copy this file to .env.local  (never commit .env.local)

# --- Safest paid AI: official OpenAI, server-side only ---
# 1. Create a project key: https://platform.openai.com/api-keys
# 2. Cap spend: https://platform.openai.com/settings/organization/limits
# 3. Paste below. Restart `npm run dev`.
# Never use NEXT_PUBLIC_ for this. Never paste the key in chat or GitHub.
OPENAI_API_KEY=

# Optional. Default is the cheaper gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Optional. Without these, Studio uses local cookie auth + .data/store.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe monthly plan (omit to allow publish without payment in local/dev)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PLAN_NAME=Support Side Hosting
NEXT_PUBLIC_PLAN_PRICE=$29/month

# Public URLs
NEXT_PUBLIC_MARKETING_URL=https://supportsidetech.com
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000
